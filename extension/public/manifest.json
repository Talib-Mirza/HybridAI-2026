{
  "manifest_version": 3,
  "name": "Waypoint",
  "version": "0.1.0",
  "description": "An in-page guide for dense web apps and consoles. Gemini Nano finds the control on your page; cloud Gemini plans multi-page routes.",
  "minimum_chrome_version": "139",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://console.firebase.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Waypoint"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "start-pick": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pick something on the page to ask Waypoint about"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.firebase.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
