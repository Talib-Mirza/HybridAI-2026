{
  "manifest_version": 3,
  "name": "Waypoint",
  "version": "0.1.0",
  "description": "Wayfinding for dense web apps: Gemini Nano finds what you need on the page, on your device; cloud Gemini plans routes across pages.",
  "minimum_chrome_version": "139",
  "permissions": [
    "sidePanel",
    "scripting",
    "tabs",
    "storage",
    "contextMenus",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://console.firebase.google.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Waypoint (Alt+Shift+W)"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle-bar": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open or close the Waypoint bar"
    },
    "start-pick": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pick something on the page to ask Waypoint about"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.firebase.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
